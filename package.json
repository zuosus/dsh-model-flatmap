{
  "name": "dsh-model-flatmap",
  "version": "1.2.1",
  "description": "Flat, two-level-free model picker for the DSH composer: every model and reasoning level on one surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zuosus/dsh-model-flatmap.git"
  },
  "bugs": {
    "url": "https://github.com/zuosus/dsh-model-flatmap/issues"
  },
  "homepage": "https://github.com/zuosus/dsh-model-flatmap#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "telemetry.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
